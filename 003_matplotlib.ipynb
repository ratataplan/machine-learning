      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Crea data\n",
        "x = [1, 2, 3, 4]\n",
        "y = [10, 20, 25, 30]\n",
        "\n",
        "# Crea un Grafico\n",
        "plt.plot(x, y, label= 'Trend', color= 'blue', marker='o')\n",
        "plt.title('Esempio di Grafico con Matplotlib')\n",
        "plt.xlabel('X-asse')\n",
        "plt.ylabel('Y-asse')\n",
        "plt.legend()\n",
        "plt.show()"
      ]
    }
